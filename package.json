{
  "name": "diva-routine",
  "productName": "Diva Routine",
  "version": "1.0.116",
  "description": "Rutinas de entrenamiento de jazz: biblioteca de videos/links, extracción de técnica y tablas visuales",
  "author": "Divolandia",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "instalador": "node desktop/preparar.js && electron-builder --win --publish never",
    "publicar": "node desktop/preparar.js && electron-builder --win --publish always",
    "web": "node web/build.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.divolandia.jazzrutinas",
    "productName": "Diva Routine",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "google.js",
      "collab.js",
      "instagram.js",
      "social.js",
      "cloud.js",
      "mega.js",
      "ai.js",
      "backup.js",
      "public/**/*",
      "desktop/main.js",
      "desktop/icon.png",
      "package.json",
      "library-history.js"
    ],
    "extraResources": [
      {
        "from": "build/config",
        "to": "config",
        "filter": [
          "*.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Diva-Routine-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Diva Routine",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DivolandiaLabs",
        "repo": "diva-routine",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "megajs": "1.3.10"
  }
}
